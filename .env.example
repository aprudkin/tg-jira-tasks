TELEGRAM_TOKEN=your_telegram_bot_token
JIRA_URL=http://your-jira-server:8080
JIRA_EMAIL=your_email@company.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PAT=your_jira_personal_access_token
# По умолчанию обязательный список Telegram user ID для приватных чатов и отправителей.
ALLOWED_USERS=123456789,987654321
# Группы закрыты по умолчанию; перечисляйте только отрицательные group/supergroup chat ID.
ALLOWED_CHAT_IDS=
# Явный escape hatch: разрешает любого известного отправителя в private chat.
ALLOW_OPEN_ACCESS=false
